# Proveedor de IA: ollama | openai | claude
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
EMBED_MODEL=nomic-embed-text

# Base de datos (para probar sin Docker: sqlite+aiosqlite:///./myagent.db)
DATABASE_URL=sqlite+aiosqlite:///./myagent.db
REDIS_URL=

# Seguridad
API_KEYS=admin-key:admin,user-key:user
MAX_ITERATIONS=5
FILES_DIR=./data/docs
HTTP_ALLOWED_HOSTS=api.github.com,worldtimeapi.org
